# Backend (placeholders only - never commit real values)
# Supabase Postgres: use the *pooler* connection string (the direct host is IPv6-only on many hosts).
# Leave unset for local development: a SQLite file is used instead.
DATABASE_URL=postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000,https://YOUR-FRONTEND.vercel.app
# Optional AI assist for the booking parser. With AI_ENABLED=false everything still works
# (deterministic parser + manual form).
AI_ENABLED=false
LLM_API_KEY=
LLM_MODEL=

# Solver and booking settings (all optional; the defaults below are what the app uses when unset)
# CP-SAT worker threads. Unset = CPU count (max 8). Use 1 on a small free instance.
SOLVER_WORKERS=
# Worker threads for the exam solver (default 8).
EXAM_WORKERS=8
# Seconds the optimiser keeps improving the soft penalty after the first valid timetable.
OPTIMISE_SECONDS=90
# Seconds allowed to find the first valid timetable.
FEASIBLE_SECONDS=180
# Rooms kept per slot while optimising (0 = all). Smaller is faster and uses less memory.
PRUNE_ROOMS=6
# Start generation from the saved best timetable when it matches the dataset exactly and the official validator accepts it
# (else the timetable is solved from scratch). Set false to always solve from scratch.
WARM_START=true
# Seconds a booking holder has to answer a voluntary move offer.
NEGOTIATION_SECONDS=300

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
